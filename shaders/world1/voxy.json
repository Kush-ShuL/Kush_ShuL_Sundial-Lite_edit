#include "/libs/SuperResolutionSettings.glsl"
{
    "version": 1,
    #ifdef HELIAN_SR_ACTIVE
    "renderScale": [SR_RENDER_SCALE_FACTOR, SR_RENDER_SCALE_FACTOR],
    "useViewportDims": true,
    #endif
    "uniforms": [
        #ifdef HELIAN_SR_ACTIVE
        "SRScaledViewportSize",
        "SROriginalViewportSize",
        "SRJitterOffset",
        "SRPreviousJitterOffset",
        #endif
        "frameCounter",
        "far",
        "rainStrength",
        "rainyStrength",
        "weatherStrength",
        "frameTimeCounter",
        "taaOffsetVX",
        "texelSize",
        "screenSize",
        "cameraPosition",
        "gbufferModelView",
        "gbufferProjection",
        "gbufferModelViewInverse",
        "gbufferProjectionInverse",
        "gbufferPreviousModelView",
        "gbufferPreviousProjection",
        "vxProj",
        "vxProjInv",
        "vxProjPrev",
        "vxRenderDistance"
    ],
    "samplers": {
        "gtexture": "sampler2D",
        "normals": "sampler2D",
        "noisetex": "sampler2D",
        "gaux2": "sampler2D",
        "depthtex0": "sampler2D",
        "depthtex1": "sampler2D",
        "vxDepthTexOpaque": "sampler2D",
        "vxDepthTexTrans": "sampler2D"
    },
    "blending": {
        "-1": "off"
    },
    "excludeLodsFromVanillaDepth": true,
    "taaOffset": "{
        #ifdef HELIAN_SR_ACTIVE
            #ifdef HELIAN_SR_JITTER
                return 2.0 * SRJitterOffset / SRScaledViewportSize;
            #else
                return vec2(0.0);
            #endif
        #else
            return taaOffsetVX;
        #endif
    }",
    "opaqueDrawBuffers": [0, 1, 2],
    "translucentDrawBuffers": [16, 17, 18]
}
